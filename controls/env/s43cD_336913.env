# graded control #336913 (s43cD): every D21 row exact (no demand-driven projection of the D21 tail)
# base: s43 #336780, estimator sha256 fa8118608705e45c0bad9feadf4414f56bdf84925b92910827f60e9d1ab7fe74
# The graded file sets this value as the knob DEFAULT and also re-records the setup spec (_POOL_SPEC). Exporting the
# variable on the s43 file instead gives the same predictions up to rounding, but the billed FLOPs differ
# (plans missing from the recorded setup spec are then built lazily during the predict).
D21_CUT=99
